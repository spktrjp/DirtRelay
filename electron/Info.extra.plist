<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Keep the relay and the SuperDirt it launches from being throttled by App Nap when the window is in the background. -->
  <key>NSAppSleepDisabled</key>
  <true/>
  <!-- Setup files (.dirtrelay) open in DirtRelay from Finder. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>DirtRelay Setup</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>dirtrelay</string></array>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
    </dict>
  </array>
</dict>
</plist>
